{
  "name": "sms-web",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "dev:admin": "turbo run dev --filter=@sms/admin",
    "dev:student": "turbo run dev --filter=@sms/student",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "turbo": "^2.5.5"
  },
  "packageManager": "npm@10.0.0"
}
