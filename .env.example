# Copy to `.env` and edit. Vars MUST be prefixed with EXPO_PUBLIC_ to be readable on the client.
#
# Local dev (iOS sim / web): http://localhost:4001
# Android emulator: http://10.0.2.2:4001 (10.0.2.2 = host machine from the emulator)
# Physical phone via Expo Go on same Wi-Fi: http://<YOUR_LAN_IP>:4001
#   Find your LAN IP with: `ip route get 1 | awk '{print $7; exit}'` on Linux,
#   or `ipconfig getifaddr en0` on macOS.

EXPO_PUBLIC_BACKEND_URL=http://localhost:4001
