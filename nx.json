{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "production": [
      "default",
      "!{projectRoot}/.next/**",
      "!{projectRoot}/dist/**"
    ],
    "sharedGlobals": ["{workspaceRoot}/config/**"],
    "publicEnv": [
      {
        "env": "NEXT_PUBLIC_BACKEND_URL"
      },
      {
        "env": "NEXT_PUBLIC_ACADEMIC_YEAR_START_MONTH"
      },
      {
        "env": "NEXT_PUBLIC_PARENT_PORTAL_URL"
      },
      {
        "env": "NEXT_PUBLIC_STUDENT_URL"
      },
      {
        "env": "NEXT_PUBLIC_SYSTEM_URL"
      },
      {
        "env": "NODE_ENV"
      },
      {
        "env": "ALLOW_LOCALHOST_BUILD"
      }
    ]
  },
  "targetDefaults": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["production", "^production", "publicEnv"],
      "cache": true,
      "outputs": ["{projectRoot}/.next", "{projectRoot}/dist"]
    },
    "lint": {
      "cache": true
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "start": {
      "cache": false,
      "persistent": true
    }
  }
}
