# Admin portal (apps/admin) — copy to .env.local for development, or set in the build environment.
#
# NEXT_PUBLIC_* values are INLINED INTO THE BUNDLE when `next build` runs;
# changing them on the server afterwards does nothing — rebuild instead.
#
# A production `next build` FAILS if a required variable below is missing or
# not a valid URL (see next.config.mjs and config/next-env-guard.mjs); http://
# or localhost values only warn. In `next dev` they fall back to localhost.
#
# Escape hatch for a local, never-deployed verification build:
#   ALLOW_LOCALHOST_BUILD=1 npx next build
# downgrades the failure to a warning and keeps the localhost fallbacks.
#
# Nx build cache: these variables (plus NODE_ENV and ALLOW_LOCALHOST_BUILD) are
# part of the build's cache key (`publicEnv` in nx.json). For a release build,
# skip the cache anyway: `npx nx build @sms/admin --skip-nx-cache`.

# REQUIRED (production build). The backend API base URL, INCLUDING /api.
# Dev fallback: http://localhost:4000/api (the backend's default PORT). If your
# backend .env sets another PORT, set this to match, e.g. http://localhost:4001/api
NEXT_PUBLIC_BACKEND_URL=https://api.nodecampus.online/api

# REQUIRED (production build). Student portal sign-in page — the admin sign-in
# screen links students here. Dev fallback: http://localhost:3001/signin
NEXT_PUBLIC_STUDENT_URL=https://student.nodecampus.online/signin

# REQUIRED (production build). System console — linked from the top bar for
# super admins. Dev fallback: http://localhost:3002
NEXT_PUBLIC_SYSTEM_URL=https://system.nodecampus.online

# REQUIRED (production build). Parent portal origin — used for public
# admission-form links and the verification QR code printed on certificates.
# Dev fallback: http://localhost:3003
NEXT_PUBLIC_PARENT_PORTAL_URL=https://parent.nodecampus.online

# OPTIONAL. Month (1–12) the academic session starts in; default 4 (April).
# MUST equal the backend's ACADEMIC_YEAR_START_MONTH, or the admin UI and the
# API disagree about which session "today" belongs to.
# NEXT_PUBLIC_ACADEMIC_YEAR_START_MONTH=4
